{
  "name": "starter-series",
  "version": "0.4.0",
  "description": "Scaffold, audit, and generate Launch Proof Reports for Starter Series projects — slash commands, skill, MCP server, and CLI.",
  "mcpName": "io.github.starter-series/create-starter",
  "type": "module",
  "bin": {
    "starter-series": "dist/index.js",
    "create-starter": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/mark-bin-executable.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test --import tsx tests/*.test.ts",
    "bundle:mcpb": "node scripts/bundle-mcpb.mjs"
  },
  "keywords": [
    "mcp",
    "starter",
    "scaffold",
    "template",
    "claude-code",
    "cli",
    "bootstrap"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starter-series/create-starter.git"
  },
  "homepage": "https://github.com/starter-series/create-starter#readme",
  "bugs": {
    "url": "https://github.com/starter-series/create-starter/issues"
  },
  "author": "heznpc",
  "files": [
    "dist",
    "skills",
    "docs/graduation-from-vibe-coding.md",
    "docs/graduation-from-vibe-coding.ko.md",
    "docs/launch-proof-report.md",
    "docs/launch-proof-report.ko.md",
    ".claude-plugin",
    ".mcp.json",
    "README.md",
    "docs/ko/README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "tar": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^25.9.2",
    "@types/tar": "^6.1.13",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fast-uri": "^3.1.2",
    "hono": "^4.12.21",
    "@hono/node-server": "^1.19.13",
    "ip-address": "^10.2.0",
    "qs": "^6.15.2",
    "tmp": "^0.2.7"
  }
}
